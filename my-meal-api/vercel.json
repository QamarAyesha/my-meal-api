{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "suppressLoaders": true,
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/.*",
      "dest": "api/index.py",
      "methods": ["GET", "POST"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "no-cache"
      }
    }
  ],
  "env": {
    "PYTHON_ENABLE_WASM": "1"
  }
}
