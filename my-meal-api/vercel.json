{
  "version": 2,
  "builds": [{
    "src": "api/index.py",
    "use": "@vercel/python",
    "config": {
      "maxLambdaSize": "50mb",
      "suppressLoaders": true,
      "includeFiles": ["model.joblib", "le_*.npy", "meal_ideas.json"],
      "runtime": "python3.9"
    }
  }],
  "env": {
    "PYTHON_ENABLE_WASM": "1",
    "PYTHON_USE_PYPI": "false",
    "VERCEL_FORCE_NO_BUILD_CACHE": "1"
  }
}
